{
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console",
			"Serilog.Sinks.File"
		],
		"MinimumLevel": {
			"Default": "Information"
		},
		"WriteTo": [
			{ "Name": "Console" },
			{
				"Name": "File",
				"Args": {
					"path": "C:\\ProgramData\\OverlayIconWatcher\\OverlayIconWatcher.log",
					"rollingInterval": "Day"
				}
			}
		]
	},
	"Interval": 5000
}
