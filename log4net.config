<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net debug="false">

		<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
			<appendToFile value="false" />
			<encoding value="utf-8"/>
			<file type="log4net.Util.PatternString" value="%env{PROGRAMDATA}\OverlayIconWatcher\OverlayIconWatcher.log" />
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%date&#9;%level&#9;%logger&#9;%message%newline"/>
			</layout>
			<maxSizeRollBackups value="24"/>
			<maximumFileSize value="1048576" />
			<rollingStyle value="Size"/>
		</appender>

		<!-- Konsole -->
		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%p %property{Table}  %m%n" />
			</layout>
			<!--<threshold value="ERROR" />-->
		</appender>

		<root>
			<level value="Info"/>
			<appender-ref ref="RollingLogFileAppender"/>
			<appender-ref ref="ConsoleAppender" />
		</root>
	</log4net>
</configuration>